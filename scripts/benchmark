#!/usr/bin/env python3
"""Measure what TR4P costs on this machine.

Starts a throw-away instance (standalone mode, temporary directory), then
reports:

  * memory when idle
  * throughput and latency of ordinary traffic
  * memory with N trapped connections held at once, and how quickly an
    ordinary visitor is still served meanwhile

Nothing outside this machine is contacted. To measure under a fixed budget,
run it inside a limited container, for example:

    docker run --rm --cpus 1 --memory 512m tr4p python /app/scripts/benchmark

Usage: python scripts/benchmark [--held 2000] [--requests 5000]
"""

from __future__ import annotations

import argparse
import asyncio
import os
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path


def free_port() -> int:
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


def rss_mb(pid: int) -> float:
    """Resident memory of a process and its children, in MB."""
    rows = []
    proc = Path("/proc")
    if (proc / str(pid) / "status").is_file():          # Linux, no tools needed
        for entry in proc.iterdir():
            if not entry.name.isdigit():
                continue
            try:
                fields = dict(line.split(":", 1) for line in
                              (entry / "status").read_text().splitlines() if ":" in line)
                rows.append((int(entry.name), int(fields["PPid"]), int(fields["VmRSS"].split()[0])))
            except (OSError, KeyError, ValueError):
                continue
    else:
        try:
            out = subprocess.run(["ps", "-o", "pid=,ppid=,rss=", "-A"], stdout=subprocess.PIPE,
                                 check=True).stdout.decode()
            rows = [tuple(int(x) for x in line.split()) for line in out.splitlines() if line.strip()]
        except (OSError, ValueError, subprocess.CalledProcessError):
            return float("nan")
    wanted = {pid} | {child for child, parent, _ in rows if parent == pid}
    return sum(rss for process, _, rss in rows if process in wanted) / 1024.0


async def fetch(port: int, path: str, agent: str, extra: str = "") -> tuple[int, float]:
    started = time.perf_counter()
    reader, writer = await asyncio.open_connection("127.0.0.1", port)
    writer.write((f"GET {path} HTTP/1.1\r\nHost: bench.example\r\nUser-Agent: {agent}\r\n"
                  f"Accept: text/html\r\nAccept-Language: en\r\nAccept-Encoding: identity\r\n"
                  f"{extra}Connection: close\r\n\r\n").encode())
    data = await reader.read()
    writer.close()
    status = int(data[9:12]) if len(data) > 12 else 0
    return status, time.perf_counter() - started


async def clean_load(port: int, total: int, parallel: int) -> tuple[float, float, float]:
    gate = asyncio.Semaphore(parallel)
    times: list[float] = []

    async def one(index: int) -> None:
        async with gate:
            status, took = await fetch(port, "/about", f"Mozilla/5.0 Chrome/{index % 400} Safari/1")
            if status == 200:
                times.append(took)

    started = time.perf_counter()
    await asyncio.gather(*(one(index) for index in range(total)))
    elapsed = time.perf_counter() - started
    times.sort()
    return len(times) / elapsed, times[len(times) // 2] * 1000, times[int(len(times) * 0.95)] * 1000


async def hold(port: int, count: int, secret: str) -> list:
    writers = []
    for start in range(0, count, 200):
        async def one(index: int):
            _, writer = await asyncio.open_connection("127.0.0.1", port)
            writer.write((f"GET / HTTP/1.1\r\nHost: bench.example\r\nUser-Agent: Mozilla/5.0 "
                          f"Chrome/{index}\r\nAccept: text/html\r\nAccept-Language: en\r\n"
                          f"Accept-Encoding: identity\r\nAuthorization: Bearer {secret}\r\n\r\n").encode())
            await writer.drain()
            return writer
        writers += await asyncio.gather(*(one(n) for n in range(start, min(count, start + 200))))
    return writers


async def measure(args, port: int, pid: int, secret: str) -> None:
    for _ in range(100):
        try:
            await fetch(port, "/", "warmup")
            break
        except OSError:
            await asyncio.sleep(0.1)
    await asyncio.sleep(1)
    print(f"idle memory (service and decoy):      {rss_mb(pid):6.0f} MB")
    rate, median, slow = await clean_load(port, args.requests, 50)
    print(f"ordinary traffic:                     {rate:6.0f} requests/s, "
          f"median {median:.1f} ms, 95% under {slow:.1f} ms")
    writers = await hold(port, args.held, secret)
    await asyncio.sleep(4)
    latency = max([(await fetch(port, "/about", "Mozilla/5.0 Chrome/1 Safari/1"))[1] for _ in range(5)])
    print(f"memory with {args.held} held connections:   {rss_mb(pid):6.0f} MB")
    print(f"ordinary visitor during the flood:    {latency * 1000:6.0f} ms (slowest of 5)")
    for writer in writers:
        writer.close()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--held", type=int, default=2000, help="trapped connections to hold")
    parser.add_argument("--requests", type=int, default=5000, help="ordinary requests to send")
    args = parser.parse_args()
    try:
        import resource
        soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
        wanted = args.held * 2 + 500
        if soft < wanted:
            resource.setrlimit(resource.RLIMIT_NOFILE,
                               (wanted if hard == resource.RLIM_INFINITY else min(wanted, hard), hard))
    except (ImportError, ValueError, OSError):
        pass

    from tr4p.config import Config
    from tr4p.honeytoken import Honeytokens
    from tr4p.seed import Seed

    with tempfile.TemporaryDirectory() as tmp:
        home = Path(tmp)
        config = Config()
        config.public.mode = "standalone"
        config.public.host = "127.0.0.1"
        config.public.port = port = free_port()
        config.public.idle_timeout = 120.0
        config.dashboard.port = free_port()
        config.tarpit.base_delay = config.tarpit.max_delay = config.tarpit.light_max_delay = 60.0
        config.tarpit.max_sessions = max(args.held, 10)
        config.maze.redirect_chance = 0.0
        config.save(home / "config.json")
        seed = Seed.generate()
        seed.save(home / "secret.key")
        secret = Honeytokens(seed).value("api_key")
        server = subprocess.Popen([sys.executable, "-m", "tr4p", "--home", str(home), "run"],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            print(f"TR4P benchmark on {os.cpu_count()} CPU(s)")
            asyncio.run(measure(args, port, server.pid, secret))
        finally:
            server.terminate()
            try:
                server.wait(timeout=15)
            except subprocess.TimeoutExpired:
                server.kill()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
